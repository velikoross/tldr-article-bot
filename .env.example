# ============================================================
#  TLDR Article Bot — настройки. Скопируйте в .env и заполните.
# ============================================================

# --- Telegram ---------------------------------------------------
# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID через запятую. Админы: все команды, без дневного лимита.
# Свой ID можно узнать, написав боту: он ответит «приватный бот» и покажет ID.
ADMIN_IDS=
# Друзья, которым можно пользоваться ботом.
ALLOWED_IDS=
# Сколько новых статей в день может обработать друг (0 — без лимита). На админов не действует.
DAILY_LIMIT_PER_USER=0

# --- Нейросеть ----------------------------------------------------
# openrouter (по умолчанию) | openai (OpenAI и любой OpenAI-совместимый API) | anthropic
LLM_PROVIDER=openrouter
LLM_API_KEY=
# Модель провайдера. Примеры:
#   openrouter: google/gemini-2.5-flash, openai/gpt-4.1-mini, deepseek/deepseek-chat
#   openai:     gpt-4.1-mini
#   anthropic:  claude-sonnet-5-5
#   ollama:     qwen2.5:14b  (LLM_PROVIDER=openai, LLM_BASE_URL=http://host:11434/v1, ключ не нужен)
LLM_MODEL=google/gemini-2.5-flash
# Адрес API. Пусто — стандартный для провайдера.
#   DeepSeek: https://api.deepseek.com/v1    Ollama: http://192.168.1.10:11434/v1
LLM_BASE_URL=
# Лимит длины ответа (токены). Меньше этого значения бот не запрашивает никогда:
# рассуждающие модели тратят токены на «мысли», и при маленьком лимите ответ обрезается или пустой.
LLM_MAX_TOKENS=8000
# Рассуждения: off | low | medium | high. Пусто — не передавать (как решит модель).
#   OpenRouter → параметр reasoning, OpenAI → reasoning_effort, Anthropic → thinking.budget_tokens.
LLM_REASONING=
# Температура (для нерассуждающих моделей)
LLM_TEMPERATURE=0.3
# Таймаут одного запроса к нейросети, секунд
LLM_TIMEOUT=180
# Размер контекста модели в токенах. Если статья не влезает, бот режет её на части,
# делает заметки по каждой и сводит итог. Для моделей с большим контекстом можно 128000 и больше.
LLM_CONTEXT_TOKENS=32000
# Сколько запросов к нейросети отправлять параллельно (части длинной статьи, перевод)
LLM_CONCURRENCY=3
# Ваши указания, которые добавляются ко всем промптам. Админ может поменять их командой /instructions.
LLM_INSTRUCTIONS=
# Дополнительные поля в тело запроса, JSON. Например, разрешённые провайдеры OpenRouter:
#   LLM_EXTRA_BODY={"provider": {"order": ["google-vertex"], "allow_fallbacks": false}}
LLM_EXTRA_BODY=

# --- Языки и переводы --------------------------------------------------
# Язык выжимки по умолчанию (каждый может поменять в /settings)
DEFAULT_LANGUAGE=ru
# Второй язык для кнопки «🌐 Перевести»
DEFAULT_TRANSLATION_LANGUAGE=en
# Полный перевод: md (файл) | telegraph (страница telegra.ph). Меняется в /settings.
FULL_TRANSLATION_FORMAT=md
# Не переводить целиком статьи длиннее этого числа символов (защита от больших счетов)
FULL_TRANSLATION_MAX_CHARS=200000

# --- Скачивание страниц ------------------------------------------------
FETCH_TIMEOUT=20
# Максимальный размер страницы или PDF, байт (5 МБ)
FETCH_MAX_BYTES=5242880
# User-Agent. Пусто — обычный браузерный.
FETCH_USER_AGENT=
# Сколько ссылок из одного сообщения разбирать
MAX_LINKS_PER_MESSAGE=5
# С какой длины текст без ссылки считается статьёй для выжимки, символов
MIN_TEXT_LENGTH=500

# --- Хранилище -------------------------------------------------------
# Сколько дней хранить кэш статей и ответов нейросети (0 — бессрочно)
CACHE_TTL_DAYS=30
DB_PATH=/data/bot.db
LOG_LEVEL=INFO
